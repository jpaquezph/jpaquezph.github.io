---
import Base from '../../../layouts/Base.astro';
import Galeria from '../../../components/Galeria.astro';
import Icon from '../../../components/Icon.astro';
import Llamado from '../../../components/Llamado.astro';
import Portada from '../../../components/Portada.astro';
import { categorias, urlAlbum, type Album, type Categoria } from '../../../lib/galeria';
import { url } from '../../../lib/rutas';

export function getStaticPaths() {
  return categorias.flatMap((c) =>
    c.albums.map((a) => ({ params: { categoria: c.slug, album: a.slug }, props: { categoria: c, album: a } })),
  );
}

interface Props {
  categoria: Categoria;
  album: Album;
}
const { categoria, album } = Astro.props;

// Proyectos anterior y siguiente: los de al lado en la categoría; en las puntas se pasa
// a la categoría vecina, y del último de todos se vuelve al primero (y al revés).
const todos = categorias.flatMap((c) => c.albums.map((a) => ({ categoria: c, album: a })));
const actual = todos.findIndex((t) => t.categoria.slug === categoria.slug && t.album.slug === album.slug);
const siguiente = todos.length > 1 ? todos[(actual + 1) % todos.length] : undefined;
const anterior = todos.length > 1 ? todos[(actual - 1 + todos.length) % todos.length] : undefined;
const rotulo = (vecino: (typeof todos)[number], enCategoria: string, palabra: string) =>
  vecino.categoria.slug === categoria.slug ? enCategoria : `${palabra} · ${vecino.categoria.nombre}`;
---

<Base titulo={`${album.nombre} · ${categoria.nombre}`} activo="portfolio/">
  <Portada
    antetitulo={`${album.fotos.length} fotos`}
    titulo={album.nombre}
    texto={album.descripcion}
    foto={album.banners?.[0] ?? album.fotos[0]}
    migas={[
      { texto: 'Portfolio', href: url('portfolio/') },
      { texto: categoria.nombre, href: url(`portfolio/${categoria.slug}/`) },
    ]}
  />
  <section class="seccion">
    <div class="contenedor">
      <Galeria fotos={album.fotos} nombre={album.nombre} />
      {
        siguiente && anterior && (
          <nav class="siguiente-album" aria-label="Otros proyectos">
            <a class="btn siguiente-album__ant" href={urlAlbum(anterior.categoria, anterior.album)}>
              <span class="siguiente-album__flecha-izq">
                <Icon nombre="flecha" tam={18} />
              </span>
              <span class="siguiente-album__texto">
                <span class="siguiente-album__ante">{rotulo(anterior, 'Proyecto anterior', 'Anterior')}</span>
                {anterior.album.nombre}
              </span>
            </a>
            <a class="btn siguiente-album__sig" href={urlAlbum(siguiente.categoria, siguiente.album)}>
              <span class="siguiente-album__texto">
                <span class="siguiente-album__ante">{rotulo(siguiente, 'Siguiente proyecto', 'Siguiente')}</span>
                {siguiente.album.nombre}
              </span>
              <Icon nombre="flecha" tam={18} />
            </a>
          </nav>
        )
      }
    </div>
  </section>
  <Llamado />
</Base>
