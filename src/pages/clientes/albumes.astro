---
import AdminCabecera from '../../components/AdminCabecera.astro';
import Base from '../../layouts/Base.astro';
---

<Base titulo="Álbumes" privada>
  <AdminCabecera
    titulo="Álbumes"
    texto="Cargá álbumes nuevos, sumá o quitá fotos y elegí la tapa. Al guardar, la web se vuelve a publicar sola en unos minutos."
    activo="albumes"
  />

  <section class="seccion seccion--compacta">
    <div class="contenedor" data-admin hidden>
      <p class="aviso aviso--estado" data-publicacion hidden></p>
      <p class="aviso" data-mensaje hidden></p>
      <div data-vista><p class="nota">Cargando…</p></div>
    </div>
  </section>

  <dialog class="dialogo" data-confirmar aria-labelledby="titulo-confirmar">
    <form method="dialog" class="formulario" data-form-confirmar>
      <h2 id="titulo-confirmar" data-titulo-confirmar>Confirmar</h2>
      <p class="texto-suave" data-texto-confirmar></p>
      <input type="text" name="username" autocomplete="username" hidden />
      <div class="campo">
        <label for="c-clave">Tu contraseña de administrador</label>
        <input id="c-clave" name="clave" type="password" autocomplete="current-password" />
      </div>
      <p class="error" data-error-confirmar></p>
      <div class="acciones">
        <button class="btn btn--peligro" type="submit" value="si">Borrar</button>
        <button class="btn" type="button" data-cancelar>Cancelar</button>
      </div>
    </form>
  </dialog>
</Base>

<script>
  import { confirmarClave } from '../../lib/admin';
  import { guardarCambio, leerEstado, ubicar, vistaPrevia, type Subida } from '../../lib/admin-contenido';
  import { seguirPublicacion } from '../../lib/admin-publicacion';
  import { exigirAdmin } from '../../lib/admin-sesion';
  import {
    agregarFotos,
    agregarPase,
    borrarAlbum,
    editarAlbum,
    elegirDestacado,
    MEDIDAS,
    nuevoAlbum,
    quitarFotos,
    quitarPase,
    type Estado,
    type Foto,
    type Resultado,
  } from '../../lib/contenido-edicion';
  import { elegirFotos, h, icono } from '../../lib/dom';
  import { prepararAlbum, prepararRecorte } from '../../lib/imagenes';
  import { url } from '../../lib/rutas';

  const panel = document.querySelector<HTMLElement>('[data-admin]')!;
  const vista = document.querySelector<HTMLElement>('[data-vista]')!;
  const mensaje = document.querySelector<HTMLElement>('[data-mensaje]')!;
  const publicacion = document.querySelector<HTMLElement>('[data-publicacion]')!;
  let estado: Estado;
  let ocupado = false;
  /** Álbum abierto: "categoria/album"; vacío = lista. */
  let abierto = '';

  function avisar(texto: string, tipo: 'info' | 'ok' | 'error' = 'info') {
    mensaje.hidden = !texto;
    mensaje.dataset.tipo = tipo;
    mensaje.textContent = texto;
  }

  const srcDe = (ruta: string) => vistaPrevia(ruta) ?? url(ruta);
  const nombreCategoria = (slug: string) => estado.contenido.categorias[slug]?.nombre ?? slug;
  const datosAlbum = (cat: string, slug: string) => estado.contenido.albumes[`${cat}/${slug}`];
  const tituloAlbum = (cat: string, slug: string, nombre: string) => datosAlbum(cat, slug)?.titulo ?? nombre;

  async function cambiar(
    descripcion: string,
    armar: (avance: (t: string) => void) => Promise<{ resultado: Resultado; subidas: Subida[]; avisos?: string[] }>,
    despues?: (r: Resultado) => void,
  ) {
    if (ocupado) return;
    ocupado = true;
    panel.classList.add('ocupado');
    try {
      avisar('Preparando…');
      const { resultado, subidas, avisos = [] } = await armar((t) => avisar(t));
      const { commit } = await guardarCambio(resultado, subidas, descripcion, (t) => avisar(t));
      estado = { contenido: resultado.contenido, galeria: resultado.galeria };
      despues?.(resultado);
      pintar();
      avisar([`Listo: ${descripcion.charAt(0).toLowerCase()}${descripcion.slice(1)}.`, ...avisos].join(' '), avisos.length ? 'info' : 'ok');
      seguirPublicacion(publicacion, commit);
    } catch (e) {
      avisar(e instanceof Error ? e.message : String(e), 'error');
    } finally {
      ocupado = false;
      panel.classList.remove('ocupado');
    }
  }

  /** Prepara varias fotos de álbum, contando el avance. */
  async function prepararVarias(archivos: File[], carpeta: string, avance: (t: string) => void) {
    const fotos: Foto[] = [];
    const subidas: Subida[] = [];
    for (const [i, archivo] of archivos.entries()) {
      avance(`Preparando fotos: ${i + 1} de ${archivos.length}…`);
      const lista = await prepararAlbum(archivo, MEDIDAS.album);
      const ubicada = ubicar(lista, carpeta, String(i + 1).padStart(3, '0'));
      fotos.push(ubicada.foto);
      subidas.push(...ubicada.subidas);
    }
    return { fotos, subidas };
  }

  // --- Confirmación con contraseña, para borrar ---

  const dialogo = document.querySelector<HTMLDialogElement>('[data-confirmar]')!;
  const formConfirmar = document.querySelector<HTMLFormElement>('[data-form-confirmar]')!;
  function pedirConfirmacion(titulo: string, texto: string): Promise<boolean> {
    document.querySelector('[data-titulo-confirmar]')!.textContent = titulo;
    document.querySelector('[data-texto-confirmar]')!.textContent = texto;
    const error = document.querySelector<HTMLElement>('[data-error-confirmar]')!;
    error.textContent = '';
    formConfirmar.reset();
    dialogo.showModal();
    return new Promise((listo) => {
      const alEnviar = async (e: SubmitEvent) => {
        e.preventDefault();
        const clave = String(new FormData(formConfirmar).get('clave') ?? '');
        if (!(await confirmarClave(clave))) {
          error.textContent = 'La contraseña no es correcta.';
          return;
        }
        cerrar(true);
      };
      const cerrar = (valor: boolean) => {
        formConfirmar.removeEventListener('submit', alEnviar);
        dialogo.close();
        listo(valor);
      };
      formConfirmar.addEventListener('submit', alEnviar);
      document.querySelector<HTMLElement>('[data-cancelar]')!.onclick = () => cerrar(false);
      dialogo.oncancel = () => cerrar(false);
    });
  }

  // --- Lista de álbumes ---

  function pintarLista() {
    const categorias = Object.keys(estado.contenido.categorias);
    const formulario = formularioNuevo(categorias);
    const grupos = categorias.map((cat) => {
      const albums = estado.galeria.categorias.find((c) => c.slug === cat)?.albums ?? [];
      return h(
        'section',
        { class: 'tarjeta lugares' },
        h('h2', {}, nombreCategoria(cat), h('span', { class: 'nota' }, ` · ${albums.length} ${albums.length === 1 ? 'álbum' : 'álbumes'}`)),
        albums.length
          ? h(
              'div',
              { class: 'lugares__grilla' },
              ...albums.map((a) => {
                const tapa = a.fotos[(datosAlbum(cat, a.slug)?.tapa ?? 1) - 1] ?? a.fotos[0];
                return h(
                  'button',
                  { class: 'lugar lugar--album', type: 'button', onclick: () => abrir(`${cat}/${a.slug}`) },
                  h('div', { class: 'lugar__foto', style: 'aspect-ratio:4/3' }, tapa && h('img', { src: srcDe(tapa.thumb), alt: '', loading: 'lazy' })),
                  h('strong', {}, tituloAlbum(cat, a.slug, a.nombre)),
                  h('span', { class: 'nota' }, `${a.fotos.length} fotos`),
                );
              }),
            )
          : h('p', { class: 'nota' }, 'Todavía no tiene álbumes.'),
      );
    });
    vista.replaceChildren(formulario, ...grupos);
  }

  function formularioNuevo(categorias: string[]) {
    const titulo = h('input', { id: 'n-titulo', name: 'titulo', placeholder: 'Cumple de 15 de Sofía', required: true });
    const descripcion = h('input', { id: 'n-descripcion', name: 'descripcion', placeholder: 'Salón Metropolitano, Rosario.' });
    const categoria = h('select', { id: 'n-categoria', name: 'categoria' }, ...categorias.map((c) => h('option', { value: c }, nombreCategoria(c))));
    const fotos = h('input', { id: 'n-fotos', name: 'fotos', type: 'file', accept: 'image/jpeg,image/png,image/webp', multiple: true });
    const form = h(
      'form',
      { class: 'tarjeta formulario', novalidate: true },
      h('h2', {}, icono('carpeta', 22), ' Nuevo álbum'),
      h(
        'div',
        { class: 'formulario__par' },
        h('div', { class: 'campo' }, h('label', { for: 'n-titulo' }, 'Título'), titulo),
        h('div', { class: 'campo' }, h('label', { for: 'n-categoria' }, 'Categoría'), categoria),
      ),
      h('div', { class: 'campo' }, h('label', { for: 'n-descripcion' }, 'Lugar o texto debajo del título (opcional)'), descripcion),
      h(
        'div',
        { class: 'campo' },
        h('label', { for: 'n-fotos' }, 'Fotos'),
        fotos,
        h('span', { class: 'nota' }, 'Se suben en el orden de sus nombres. Se achican solas a 2000 px del lado más largo.'),
      ),
      h('div', { class: 'acciones' }, h('button', { class: 'btn btn--lleno', type: 'submit' }, 'Crear álbum')),
    );
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const archivos = [...(fotos.files ?? [])].sort((a, b) => a.name.localeCompare(b.name, 'es', { numeric: true }));
      if (!titulo.value.trim()) return avisar('Poné un título para el álbum.', 'error');
      if (!archivos.length) return avisar('Elegí las fotos del álbum.', 'error');
      const cat = categoria.value;
      let creado = '';
      cambiar(
        `Nuevo álbum "${titulo.value.trim()}" en ${nombreCategoria(cat)}`,
        async (avance) => {
          // El nombre de la carpeta sale del título; se calcula antes para ubicar las fotos.
          const previo = nuevoAlbum(estado, cat, { titulo: titulo.value, descripcion: descripcion.value }, [{ src: 'x', thumb: 'x', w: 1, h: 1, color: '' }]);
          const { fotos: listas, subidas } = await prepararVarias(archivos, `fotos/${cat}/${previo.slug}`, avance);
          const resultado = nuevoAlbum(estado, cat, { titulo: titulo.value, descripcion: descripcion.value }, listas);
          creado = `${cat}/${resultado.slug}`;
          return { resultado, subidas };
        },
        () => (abierto = creado),
      );
    });
    return form;
  }

  // --- Un álbum ---

  function abrir(clave: string) {
    abierto = clave;
    avisar('');
    pintar();
    window.scrollTo({ top: 0 });
  }

  function pintarAlbum(cat: string, slug: string) {
    const album = estado.galeria.categorias.find((c) => c.slug === cat)?.albums.find((a) => a.slug === slug);
    if (!album) {
      abierto = '';
      return pintarLista();
    }
    const datos = datosAlbum(cat, slug);
    const tapaActual = datos?.tapa ?? 1;
    const esDestacado = estado.contenido.destacado.categoria === cat && estado.contenido.destacado.album === slug;
    const enDestacado = new Set(esDestacado ? estado.contenido.destacado.fotos : []);
    const nombre = tituloAlbum(cat, slug, album.nombre);

    const titulo = h('input', { id: 'e-titulo', value: nombre });
    const descripcion = h('input', { id: 'e-descripcion', value: datos?.descripcion ?? '' });
    const guardarDatos = h('form', { class: 'tarjeta formulario', novalidate: true },
      h('h2', {}, icono('documento', 22), ' Datos'),
      h('div', { class: 'formulario__par' },
        h('div', { class: 'campo' }, h('label', { for: 'e-titulo' }, 'Título'), titulo),
        h('div', { class: 'campo' }, h('label', { for: 'e-descripcion' }, 'Lugar o texto debajo del título'), descripcion),
      ),
      h('div', { class: 'acciones' }, h('button', { class: 'btn', type: 'submit' }, 'Guardar datos')),
    );
    guardarDatos.addEventListener('submit', (e) => {
      e.preventDefault();
      cambiar(`Datos del álbum "${titulo.value.trim()}"`, async () => ({
        resultado: editarAlbum(estado, cat, slug, { titulo: titulo.value, descripcion: descripcion.value, tapa: tapaActual }),
        subidas: [],
      }));
    });

    // Fotos: cada una con su número, tilde para elegirla y marca de tapa / destacado.
    const tildadas = new Set<number>();
    const contador = h('span', { class: 'nota' }, 'Tocá las fotos para elegirlas.');
    const botonesSeleccion: HTMLButtonElement[] = [];
    const actualizarSeleccion = () => {
      contador.textContent = tildadas.size ? `${tildadas.size} elegida${tildadas.size === 1 ? '' : 's'}.` : 'Tocá las fotos para elegirlas.';
      botonesSeleccion.forEach((b) => (b.disabled = !tildadas.size));
      botonTapa.disabled = tildadas.size !== 1;
    };
    const grilla = h('div', { class: 'admin-fotos-album' },
      ...album.fotos.map((foto, i) => {
        const numero = i + 1;
        const boton = h('button', { type: 'button', class: 'foto-album', 'aria-pressed': 'false', title: `Foto ${numero}` },
          h('img', { src: srcDe(foto.thumb), alt: `Foto ${numero}`, loading: 'lazy' }),
          h('span', { class: 'foto-album__numero' }, numero),
          numero === tapaActual && h('span', { class: 'foto-album__marca' }, 'Tapa'),
          enDestacado.has(numero) && h('span', { class: 'foto-album__marca foto-album__marca--destacado' }, 'Inicio'),
        );
        boton.addEventListener('click', () => {
          if (tildadas.has(numero)) tildadas.delete(numero);
          else tildadas.add(numero);
          boton.setAttribute('aria-pressed', String(tildadas.has(numero)));
          actualizarSeleccion();
        });
        return boton;
      }),
    );

    const botonTapa = h('button', { class: 'btn', type: 'button', disabled: true, onclick: () => {
      const [tapa] = [...tildadas];
      cambiar(`Nueva tapa del álbum "${nombre}"`, async () => ({
        resultado: editarAlbum(estado, cat, slug, { titulo: nombre, descripcion: datos?.descripcion ?? '', tapa }),
        subidas: [],
      }));
    } }, 'Usar como tapa');
    const botonDestacado = h('button', { class: 'btn', type: 'button', disabled: true, onclick: () => {
      if (tildadas.size > 6 && !confirm('El destacado de inicio muestra hasta 6 fotos: se usan las primeras 6 elegidas. ¿Seguir?')) return;
      cambiar(`Destacado de inicio: "${nombre}"`, async () => ({
        resultado: elegirDestacado(estado, cat, slug, {
          texto: esDestacado ? estado.contenido.destacado.texto : (datos?.descripcion ?? ''),
          fotos: [...tildadas],
        }),
        subidas: [],
      }));
    } }, 'Mostrar en el destacado de inicio');
    const botonQuitar = h('button', { class: 'btn btn--peligro', type: 'button', disabled: true, onclick: () => {
      const n = tildadas.size;
      if (!confirm(`¿Quitar ${n} foto${n === 1 ? '' : 's'} del álbum? Se borra${n === 1 ? '' : 'n'} de toda la web y del repositorio.`)) return;
      cambiar(`Quitar ${n} foto${n === 1 ? '' : 's'} de "${nombre}"`, async () => ({
        resultado: quitarFotos(estado, cat, slug, [...tildadas]),
        subidas: [],
      }));
    } }, 'Quitar elegidas');
    botonesSeleccion.push(botonDestacado, botonQuitar);

    const agregar = h('button', { class: 'btn btn--lleno', type: 'button', onclick: async () => {
      const archivos = (await elegirFotos(true)).sort((a, b) => a.name.localeCompare(b.name, 'es', { numeric: true }));
      if (!archivos.length) return;
      cambiar(`Sumar ${archivos.length} foto${archivos.length === 1 ? '' : 's'} a "${nombre}"`, async (avance) => {
        const { fotos, subidas } = await prepararVarias(archivos, `fotos/${cat}/${slug}`, avance);
        return { resultado: agregarFotos(estado, cat, slug, fotos), subidas };
      });
    } }, icono('arriba', 16), ' Sumar fotos');

    const fotos = h('section', { class: 'tarjeta formulario' },
      h('h2', {}, icono('camara', 22), ` Fotos (${album.fotos.length})`),
      h('div', { class: 'acciones' }, agregar, botonTapa, botonDestacado, botonQuitar, contador),
      grilla,
    );

    // Pase del álbum: fotos 1180 x 320 que pasan en la página de la categoría (la primera también es el fondo del encabezado).
    const pase = estado.contenido.categorias[cat]?.banners?.[slug] ?? [];
    const seccionPase = h('section', { class: 'tarjeta formulario' },
      h('h2', {}, icono('montana', 22), ' Pase de fotos del álbum'),
      h('p', { class: 'nota' }, `${MEDIDAS.pase.ancho} × ${MEDIDAS.pase.alto} px. Pasan en la página de ${nombreCategoria(cat)}; la primera también es el fondo del encabezado del álbum. Sin fotos propias, la web usa fotos apaisadas del álbum.`),
      h('div', { class: 'lugares__grilla' },
        ...pase.map((foto, i) => h('article', { class: 'lugar' },
          h('div', { class: 'lugar__foto', style: `aspect-ratio:${MEDIDAS.pase.ancho}/${MEDIDAS.pase.alto}` }, h('img', { src: srcDe(foto.src), alt: '' })),
          h('strong', {}, `Foto ${i + 1} del pase`),
          h('div', { class: 'acciones' }, h('button', { class: 'btn btn--peligro', type: 'button', onclick: () => {
            if (!confirm('¿Quitar esta foto del pase? Se borra de la web y del repositorio.')) return;
            cambiar(`Quitar una foto del pase de "${nombre}"`, async () => ({ resultado: quitarPase(estado, cat, slug, i), subidas: [] }));
          } }, 'Quitar')),
        )),
        h('button', { class: 'lugar lugar--agregar', type: 'button', onclick: async () => {
          const [archivo] = await elegirFotos();
          if (!archivo) return;
          cambiar(`Nueva foto en el pase de "${nombre}"`, async () => {
            const lista = await prepararRecorte(archivo, MEDIDAS.pase);
            const { foto, subidas } = ubicar(lista, 'sitio', `pase-${cat}-${slug}`.slice(0, 60));
            return { resultado: agregarPase(estado, cat, slug, foto), subidas, avisos: lista.aviso ? [lista.aviso] : [] };
          });
        } }, icono('arriba', 22), h('strong', {}, 'Agregar foto al pase')),
      ),
    );

    const zonaBorrar = h('section', { class: 'tarjeta formulario' },
      h('h2', {}, 'Borrar álbum'),
      h('p', { class: 'nota' }, esDestacado
        ? 'Es el trabajo destacado de la página de inicio: para borrarlo, primero elegí otro álbum como destacado.'
        : 'Se borran todas sus fotos y sus fotos del pase, de la web y del repositorio.'),
      h('div', { class: 'acciones' }, h('button', { class: 'btn btn--peligro', type: 'button', disabled: esDestacado, onclick: async () => {
        const ok = await pedirConfirmacion(`Borrar "${nombre}"`, `Se borran sus ${album.fotos.length} fotos de toda la web y del repositorio. No se puede deshacer desde el panel.`);
        if (!ok) return;
        cambiar(`Borrar el álbum "${nombre}"`, async () => ({ resultado: borrarAlbum(estado, cat, slug), subidas: [] }), () => (abierto = ''));
      } }, 'Borrar álbum')),
    );

    vista.replaceChildren(
      h('div', { class: 'cabecera-seccion' },
        h('div', {}, h('span', { class: 'antetitulo' }, nombreCategoria(cat)), h('h2', { class: 'titulo' }, nombre)),
        h('div', { class: 'acciones' },
          h('a', { class: 'enlace', href: url(`portfolio/${cat}/${slug}/`), target: '_blank', rel: 'noopener' }, 'Ver en la web'),
          h('button', { class: 'enlace', type: 'button', style: 'background:none;border:0;cursor:pointer', onclick: () => abrir('') }, icono('izquierda', 15), ' Volver a la lista'),
        ),
      ),
      guardarDatos,
      fotos,
      seccionPase,
      zonaBorrar,
    );
  }

  function pintar() {
    if (abierto) {
      const [cat, slug] = abierto.split('/');
      pintarAlbum(cat, slug);
    } else pintarLista();
  }

  exigirAdmin(panel).then(async (admin) => {
    if (!admin) return;
    try {
      estado = await leerEstado();
      pintar();
      seguirPublicacion(publicacion);
    } catch (e) {
      vista.replaceChildren();
      avisar(e instanceof Error ? e.message : String(e), 'error');
    }
  });
</script>
